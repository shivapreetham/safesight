{
  "manifest_version": 3,
  "name": "SafeSight",
  "description": "Blurs NSFW images on web pages using the SafeSight RQSA-MIL moderation API.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SafeSight"
  }
}
